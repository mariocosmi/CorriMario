<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CorriMario.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid RowDefinitions="Auto,*,100,50" Padding="12">

        <!-- Title Panel -->
        <StackPanel Grid.Row="0" Margin="0,17,0,28">
            <Label x:Name="ApplicationTitle"
                   Text="CORRI MARIO"
                   FontSize="18"
                   FontAttributes="Bold"/>
            <Label x:Name="PageTitle"
                   Text="Musettometro"
                   Margin="9,-7,0,0"
                   FontSize="32"
                   FontAttributes="Bold"/>
        </StackPanel>

        <!-- Content Panel - Musettometro visualization -->
        <Grid x:Name="ContentPanel" Grid.Row="1">
            <Image x:Name="imgMusetto"
                   Aspect="AspectFill">
                <Image.Clip>
                    <RectangleGeometry x:Name="clipMusetto" Rect="0,0,0,0"/>
                </Image.Clip>
            </Image>
            <Image x:Name="imgMusettoSfondo"
                   Aspect="AspectFill">
                <Image.Clip>
                    <RectangleGeometry x:Name="clipMusettoSfondo" Rect="0,0,0,0"/>
                </Image.Clip>
            </Image>
        </Grid>

        <!-- Start/Stop Button -->
        <Button Grid.Row="2"
                x:Name="btnStartStop"
                Text="Inizia a correre"
                Clicked="Button_Clicked"
                FontSize="20"
                Margin="0,10"/>

        <!-- Distance Display -->
        <Label Grid.Row="3"
               Text="{Binding Distanza}"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               FontSize="18"/>
    </Grid>

</ContentPage>
